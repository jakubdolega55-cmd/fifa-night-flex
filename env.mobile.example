# Ten sam Neon co w Streamlit Cloud.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# To samo hasło, którym odblokowujesz sterowanie w Streamlit.
ADMIN_PASSWORD=zmien-mnie

# Osobny długi sekret do podpisywania tokenów urządzeń.
# Jeśli go nie ustawisz, API użyje ADMIN_PASSWORD, ale osobny sekret jest lepszy.
MOBILE_TOKEN_SECRET=wygeneruj-dlugi-losowy-sekret
