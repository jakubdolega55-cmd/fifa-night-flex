{
  "name": "fifa-night-mobile",
  "version": "1.1.3",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npm run verify:teams && expo start",
    "android": "npm run verify:teams && expo start --android",
    "check": "tsc --noEmit",
    "build:apk": "npm run verify:teams && eas build --platform android --profile preview",
    "web": "npm run verify:teams && expo start --web",
    "build:web": "npm run verify:teams && expo export --platform web && node scripts/pwa-postbuild.mjs && node scripts/pwa-verify.mjs",
    "check:web": "tsc --noEmit",
    "verify:web": "node scripts/pwa-verify.mjs",
    "verify:teams": "node scripts/verify-team-assets.mjs"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@expo/metro-runtime": "~57.0.15",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
